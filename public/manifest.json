{
  "manifest_version": 3,
  "name": "QuickPhish",
  "version": "1.0",
  "permissions": ["activeTab", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}